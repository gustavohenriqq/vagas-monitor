# =============================================================
# Vagas Monitor — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# NUNCA commite o arquivo .env com valores secretos.
# =============================================================

# --- Telegram ---
# Token do bot criado via @BotFather (formato: 123456789:AA...)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ID do chat ou canal para receber as notificações
# Use @userinfobot para descobrir seu chat ID
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- Comportamento ---

# Notificar vagas já existentes na primeira execução?
# true = notifica todas | false = apenas registra (recomendado)
INITIAL_NOTIFY=false

# Enviar resumo ao final de cada execução?
SEND_SUMMARY=false

# Enviar resumo mesmo quando não houver vagas novas?
SEND_EMPTY_SUMMARY=false

# Enviar o digest ranqueado nesta execução? (no Actions, sai na run das 20h BRT)
SEND_DIGEST=false

# Score mínimo (0-10) para notificar na hora. Abaixo disso, vai pro digest.
HIGH_SCORE_THRESHOLD=7

# --- Limites ---

# Número máximo de vagas coletadas por busca em cada provider (paginação)
MAX_JOBS_PER_SEARCH=200

# Intervalo em segundos entre requisições HTTP
REQUEST_DELAY_SECONDS=1.0

# --- Logging ---
# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Caminhos (opcional) ---
# SEARCHES_PATH=config/searches.yaml
# STORAGE_PATH=data/jobs.json
